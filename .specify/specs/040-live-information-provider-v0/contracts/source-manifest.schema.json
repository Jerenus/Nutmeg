{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nutmeg Information Source Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cache_ttl_seconds": { "type": "integer", "minimum": 0 },
    "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "max_bytes": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "source_name": { "type": "string" },
          "kind": { "enum": ["local_json", "local_rss", "remote_json", "remote_rss"] },
          "enabled": { "type": "boolean" },
          "path": { "type": "string" },
          "url": { "type": "string" },
          "reliability": { "enum": ["official", "credible", "rumor", "unverified"] },
          "fixture_ids": { "type": "array", "items": { "type": "string" } },
          "teams": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "cache_ttl_seconds": { "type": "integer", "minimum": 0 },
          "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "max_bytes": { "type": "integer", "minimum": 1 }
        },
        "required": ["source_name", "kind"]
      }
    }
  },
  "required": ["sources"]
}
