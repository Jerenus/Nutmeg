{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nutmeg Zucai Source Sync Result v0",
  "type": "object",
  "required": ["generated_at", "run_date", "parsed_count", "written_issue_paths", "registry_path", "active_issue_ids", "warnings"],
  "properties": {
    "generated_at": {"type": "string"},
    "run_date": {"type": "string"},
    "source_label": {"type": "string"},
    "source_url": {"type": ["string", "null"]},
    "source_path": {"type": ["string", "null"]},
    "parsed_count": {"type": "integer", "minimum": 0},
    "written_issue_paths": {"type": "object", "additionalProperties": {"type": "string"}},
    "registry_path": {"type": "string"},
    "active_issue_ids": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
