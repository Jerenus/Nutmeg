NUTMEG_APP_ENV=dev
NUTMEG_DEFAULT_USER_ID=owner
NUTMEG_DATA_DIR=.nutmeg-data
NUTMEG_DEFAULT_SYNC_DAYS=30
NUTMEG_SYNC_TIMEZONE=UTC
NUTMEG_LANGSMITH_ENABLED=false
NUTMEG_LANGSMITH_PROJECT=nutmeg-local
NUTMEG_PORTKEY_BASE_URL=https://api.portkey.ai/v1
NUTMEG_PORTKEY_API_KEY=
NUTMEG_ANTHROPIC_MODEL=claude-sonnet-4-5
NUTMEG_AGENT_SYNTHESIS_ENABLED=false
NUTMEG_OPENAI_BASE_URL=https://api.openai.com/v1
NUTMEG_OPENAI_API_KEY=
NUTMEG_BOT_LLM_FALLBACK_ENABLED=false
NUTMEG_BOT_LLM_FALLBACK_MODEL=gpt-5.5
NUTMEG_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io/
NUTMEG_API_FOOTBALL_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
