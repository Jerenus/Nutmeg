{
  "id": "nutmeg-ticket-confirmation",
  "name": "Nutmeg Ticket Confirmation",
  "description": "Routes owner Telegram placement attestations to the Nutmeg ontology.",
  "activation": {
    "onStartup": false
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "projectRoot",
      "accountId",
      "ownerInstanceId",
      "allowedChatIds",
      "allowedSenderIds"
    ],
    "properties": {
      "projectRoot": {
        "type": "string",
        "minLength": 1
      },
      "accountId": {
        "const": "nutmeg"
      },
      "ownerInstanceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "allowedChatIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      },
      "allowedSenderIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "heartbeatIntervalSeconds": {
        "type": "integer",
        "minimum": 10,
        "maximum": 60,
        "default": 30
      },
      "leaseSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 300,
        "default": 90
      }
    }
  },
  "version": "0.1.0",
  "contracts": {
    "tools": []
  }
}
